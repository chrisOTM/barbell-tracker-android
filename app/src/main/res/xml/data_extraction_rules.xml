<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same data for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="barbell_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="barbell_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
